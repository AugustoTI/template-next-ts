{
  "name": "template-next-ts",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
